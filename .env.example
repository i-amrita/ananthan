# Copy to `.env` (gitignored) and fill in. PUBLIC_* values are inlined into the built site; AI_* values are build-time tooling only and never shipped.
# Unset or empty values fall back to the placeholders in `src/lib/site.ts`.

# Contact address used by the "Let's build" key and the Copy email action.
PUBLIC_EMAIL=hello@example.com

# Profile links used by the pad link keys and the About links.
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/your-handle
PUBLIC_RESEARCH_URL=https://example.com/research

# Optional. Leave empty to hide the CV link.
PUBLIC_CV_URL=

# intl-ai translation provider (OpenAI-compatible; here the local Bifrost gateway). Used by `pnpm intl-ai:fill`, never shipped.
# Key lives in macOS Keychain (item `bifrost`, account $USER). Never commit the real value.
AI_BASE_URL=http://localhost:8317/v1
AI_MODEL_ID=zai-coding-plan/glm-4.5-air
AI_API_KEY=
