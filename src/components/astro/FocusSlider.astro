---
/**
 * Hero focus slider: four full-viewport panels on a native `scroll-snap` track.
 * The slider is the home navigation: each panel links into its route.
 * Camera cues are CSS only: depth-of-field blur on the neighbours, viewfinder corner brackets
 * on the focused panel, `zoom-in` cursor on fine pointers.
 *
 * A small inline script adds desktop arrow-key navigation, drag momentum and snap assist.
 * Without JavaScript the track is still a real scroll container with real links.
 */
import { m } from '@/lib/i18n';

interface Panel {
  label: string;
  body: string;
  href: string;
  cta: string;
  route: string;
  photo: {
    src: string;
    webp: string;
    srcset: string;
    width: number;
    height: number;
    alt: string;
    position: string;
  };
}

/* Full-bleed panel photographs, owner-supplied. Neutral alt text; nothing is claimed about
   the owner. The scans are trimmed to the film area (no letterbox), so the stated dimensions
   are the real image dimensions. Object position is per panel so `cover` keeps the subject
   in frame at phone, tablet and desktop crops. The srcset carries the two real downscales
   (480 and 960 px wide); no upscaled files are fabricated. */
const panelPhotos: Record<string, Panel['photo']> = {
  home: {
    src: '/photos/2024-09-15-1.jpg',
    webp: '/photos/2024-09-15-1.webp',
    srcset: '/photos/2024-09-15-1-480.webp 480w, /photos/2024-09-15-1-960.webp 960w, /photos/2024-09-15-1.webp 1000w',
    width: 1000,
    height: 660,
    alt: 'Colour photograph of a row of houses beside railway tracks under a cloudy sky.',
    position: 'center 50%',
  },
  research: {
    src: '/photos/2024-10-16-1.jpg',
    webp: '/photos/2024-10-16-1.webp',
    srcset: '/photos/2024-10-16-1-480.webp 480w, /photos/2024-10-16-1-960.webp 960w, /photos/2024-10-16-1.webp 1080w',
    width: 1080,
    height: 720,
    alt: 'Black-and-white photograph of a laboratory bench with a benchtop centrifuge and glassware by a window.',
    position: 'center 50%',
  },
  life: {
    /* P2b: the previous life asset (2024-10-16-2) is a tight face crop whose source scan has
       no pixels above the head, so no object-position could restore the missing forehead.
       This alternative scan of the same frame carries the full head; it is cropped to the
       3:2 band at y 250-970 of the square scan, keeping the face and the corn with headroom. */
    src: '/photos/2024-10-16-3.jpg',
    webp: '/photos/2024-10-16-3.webp',
    srcset: '/photos/2024-10-16-3-480.webp 480w, /photos/2024-10-16-3-960.webp 960w, /photos/2024-10-16-3.webp 1080w',
    width: 1080,
    height: 720,
    alt: 'Black-and-white photograph of a seated person holding an ear of corn.',
    position: 'center 30%',
  },
  photography: {
    src: '/photos/2024-10-10-1.jpg',
    webp: '/photos/2024-10-10-1.webp',
    srcset: '/photos/2024-10-10-1-480.webp 480w, /photos/2024-10-10-1-960.webp 960w, /photos/2024-10-10-1.webp 1080w',
    width: 1080,
    height: 720,
    alt: 'Black-and-white photograph of a bearded person sitting on a chair in a glass-walled lobby.',
    position: 'center 40%',
  },
};

/* Focus-distance stops, text only. One per panel, in panel order. */
const stops = ['0.30', '0.50', '0.70', '1.00'];

const panels: Panel[] = [
  {
    label: m.hero_intro_label(),
    body: m.hero_intro_body(),
    href: '/life',
    cta: m.hero_enter(),
    route: 'home',
    photo: panelPhotos.home!,
  },
  {
    label: m.hero_research_label(),
    body: m.hero_research_body(),
    href: '/research',
    cta: m.nav_research(),
    route: 'research',
    photo: panelPhotos.research!,
  },
  {
    label: m.hero_life_label(),
    body: m.hero_life_body(),
    href: '/life',
    cta: m.nav_life(),
    route: 'life',
    photo: panelPhotos.life!,
  },
  {
    label: m.hero_photography_label(),
    body: m.hero_photography_body(),
    href: '/photography',
    cta: m.nav_photography(),
    route: 'photography',
    photo: panelPhotos.photography!,
  },
];
---

<section
  class="focus-track"
  data-focus-track
  tabindex="0"
  role="group"
  aria-label={m.hero_panels()}
  data-panel-count={panels.length}
>
  {
    panels.map((p, i) => (
      <article
        class="focus-panel"
        data-focus-panel={i}
        data-route={p.route}
        aria-roledescription="panel"
      >
        <picture class="focus-photo">
          <source srcset={p.photo.srcset} sizes="100vw" type="image/webp" />
          <img
            src={p.photo.src}
            alt={p.photo.alt}
            width={p.photo.width}
            height={p.photo.height}
            style={`object-position:${p.photo.position};`}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </picture>
        <div class="focus-scrim" aria-hidden="true" />
        <span class="viewfinder" aria-hidden="true">
          <i class="corner tl" />
          <i class="corner tr" />
          <i class="corner bl" />
          <i class="corner br" />
        </span>
        <div class="focus-inner">
          <p class="focus-index font-mono text-xs tracking-widest text-muted-foreground uppercase">
            {String(i + 1).padStart(2, '0')} / {String(panels.length).padStart(2, '0')}
          </p>
          {i === 0 ? <h1 class="sr-only">{m.hero_name()}</h1> : null}
          <h2 class="focus-title font-display">{p.label}</h2>
          <p class="focus-body">{p.body}</p>
          <a class="focus-cta" href={p.href}>
            {p.cta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))
  }
</section>

<div class="focus-progress" data-focus-progress>
  <div class="focus-progress-track" data-focus-progress-track role="presentation">
    <span class="focus-progress-fill" data-focus-progress-fill />
  </div>
</div>

<div class="focus-vignette" aria-hidden="true"></div>

<div class="focus-ruler" data-focus-ruler>
  <div class="ruler-viewport" data-ruler-viewport>
    <div class="ruler-strip" data-ruler-strip>
      {
        panels.map((p, i) => (
          <span class="ruler-stop" data-stop={i} data-label={p.label} style={`--i:${i};`}>
            <span class="ruler-label font-mono">
              {String(i + 1).padStart(2, '0')} {p.label}
            </span>
            <span class="ruler-dot" />
            <span class="ruler-num font-mono">{stops[i]}</span>
          </span>
        ))
      }
    </div>
    <span class="ruler-needle" aria-hidden="true"></span>
  </div>
  <p class="ruler-readout font-mono" aria-hidden="true">
    FOCUS <span data-focus-value>{stops[0]}</span> M
  </p>
</div>

<p class="sr-only" data-focus-live aria-live="polite" aria-atomic="true"></p>

<p class="sr-only" data-focus-hint>{m.hero_hint()}</p>

<span class="focus-chip font-mono" data-focus-chip aria-hidden="true">‹ ›</span>

<script>
  /**
   * Behaviour on top of the native scroll-snap track: arrow keys, drag with momentum, the
   * `?panel=` URL state, the focus-scale ruler, and tap / Enter activation.
   * Everything degrades to a plain scroll container with real links when JavaScript is off.
   */
  const track = document.querySelector<HTMLElement>('[data-focus-track]');
  if (track) {
    const panels = [...track.querySelectorAll<HTMLElement>('[data-focus-panel]')];
    const progress = document.querySelector<HTMLElement>('[data-focus-progress]');
    const ruler = document.querySelector<HTMLElement>('[data-focus-ruler]');
    const rulerView = document.querySelector<HTMLElement>('[data-ruler-viewport]');
    const rulerStops = [...document.querySelectorAll<HTMLElement>('[data-stop]')];
    const readout = document.querySelector<HTMLElement>('[data-focus-value]');
    const live = document.querySelector<HTMLElement>('[data-focus-live]');
    const chip = document.querySelector<HTMLElement>('[data-focus-chip]');
    const count = panels.length;
    // Focus distance per panel, text only. Mirrors the stops rendered in the markup.
    const stopValues = [0.3, 0.5, 0.7, 1.0];
    // Same literal as `OPEN_OVERLAY_EVENT` in FocusOverlays.tsx (the island is not imported here).
    const OPEN_OVERLAY_EVENT = 'ananthan:open-overlay';
    const TAP_MAX_MOVE = 6;
    const TAP_MAX_MS = 250;
    let index = 0;
    let reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const current = () => {
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      panels.forEach((p, i) => {
        const center = p.offsetLeft + p.clientWidth / 2;
        const d = Math.abs(center - mid);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      return best;
    };

    /** Fractional panel position, 0..count-1, from the track scroll offset. */
    const position = () => {
      const w = track.clientWidth || 1;
      return Math.max(0, Math.min(count - 1, track.scrollLeft / w));
    };

    /** Ruler step in px: distance between two adjacent stops. */
    const stepPx = () => {
      const a = rulerStops[0];
      const b = rulerStops[1];
      return a && b ? b.offsetLeft - a.offsetLeft || 1 : 1;
    };

    // Ruler paint: one custom property drives the strip transform (no layout), and the
    // readout interpolates between the two surrounding stops.
    const paintRuler = () => {
      const p = position();
      ruler?.style.setProperty('--p', p.toFixed(4));
      if (readout) {
        const lo = Math.floor(p);
        const hi = Math.min(count - 1, lo + 1);
        const t = p - lo;
        const v = stopValues[lo]! + (stopValues[hi]! - stopValues[lo]!) * t;
        readout.textContent = v.toFixed(2);
      }
    };

    const paint = () => {
      const prev = index;
      index = current();
      panels.forEach((p, i) => {
        p.toggleAttribute('data-focused', i === index);
        // Blur only applies to panels JS has marked as neighbours; the default is sharp.
        p.dataset.focusState = i === index ? 'focused' : 'neighbour';
      });
      rulerStops.forEach((s, i) => {
        s.toggleAttribute('data-focused', i === index);
      });
      if (live && (index !== prev || !live.textContent)) {
        live.textContent = panels[index]?.querySelector('.focus-title')?.textContent ?? '';
      }
      // The progress bar fills to (focused + 1) / count. A width write only, so no layout churn.
      if (progress) {
        progress.style.setProperty('--progress', String((index + 1) / count));
      }
      const url = new URL(location.href);
      if (index === 0) url.searchParams.delete('panel');
      else url.searchParams.set('panel', String(index));
      history.replaceState(history.state, '', url);
    };

    const goTo = (i: number) => {
      const next = Math.max(0, Math.min(count - 1, i));
      const panel = panels[next];
      if (!panel) return;
      track.scrollTo({ left: panel.offsetLeft, behavior: reduced ? 'auto' : 'smooth' });
      index = next;
      paint();
    };

    /** Open the overlay for a panel. The island listens for the event; without it, follow the link. */
    const openPanel = (i: number) => {
      const panel = panels[i];
      const route = panel?.dataset.route;
      if (!panel || !route) return;
      if (document.documentElement.hasAttribute('data-overlay-ready')) {
        window.dispatchEvent(new CustomEvent(OPEN_OVERLAY_EVENT, { detail: route }));
      } else {
        const href = panel.querySelector<HTMLAnchorElement>('.focus-cta')?.href;
        if (href) location.assign(href);
      }
    };

    /** Tap, click or Enter on a panel: focus it, or open it if it already has focus. */
    const activate = (i: number) => {
      if (document.documentElement.hasAttribute('data-overlay-open')) return;
      if (i !== index) goTo(i);
      // The intro has no page: activating it advances to the first real panel.
      else if (i === 0) goTo(1);
      else openPanel(i);
    };

    // Keys, when the track itself has focus.
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        goTo(index + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        goTo(index - 1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        goTo(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        goTo(count - 1);
      } else if ((e.key === 'Enter' || e.key === ' ') && e.target === track) {
        e.preventDefault();
        activate(index);
      }
    });

    // The CTA is a real link for no-JS. With JS it is the explicit activation of its panel.
    track.addEventListener('click', (e) => {
      const cta = (e.target as Element).closest<HTMLAnchorElement>('.focus-cta');
      if (!cta || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const i = panels.indexOf(cta.closest<HTMLElement>('[data-focus-panel]')!);
      if (i < 0) return;
      e.preventDefault();
      activate(i);
    });

    // Pointer handling on the track. Touch scrolls natively; mouse drags with momentum.
    // A tap is movement < 6px and < 250ms; only a tap can activate, so a flick never opens anything.
    let dragging = false;
    let captured = false;
    let startX = 0;
    let startY = 0;
    let startT = 0;
    let startScroll = 0;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0;
    let tapTarget: Element | null = null;

    track.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      startX = e.clientX;
      startY = e.clientY;
      startT = performance.now();
      tapTarget = e.target as Element;
      if (e.pointerType === 'touch') return; // native touch scrolling already works
      dragging = true;
      captured = false;
      lastX = e.clientX;
      lastT = startT;
      velocity = 0;
      startScroll = track.scrollLeft;
      track.setAttribute('data-dragging', '');
    });

    track.addEventListener('pointermove', (e) => {
      if (chip && e.pointerType !== 'touch') {
        chip.style.transform = `translate3d(${e.clientX + 16}px, ${e.clientY + 16}px, 0)`;
        chip.toggleAttribute('data-visible', true);
      }
      if (!dragging) return;
      const dx = e.clientX - startX;
      // Capture only once it is a real drag, so a plain click still reaches links.
      if (!captured && Math.abs(dx) > TAP_MAX_MOVE) {
        captured = true;
        track.setPointerCapture(e.pointerId);
      }
      track.scrollLeft = startScroll - dx;
      const now = performance.now();
      const dt = now - lastT;
      if (dt > 0) velocity = (e.clientX - lastX) / dt;
      lastX = e.clientX;
      lastT = now;
    });

    track.addEventListener('pointerleave', () => chip?.removeAttribute('data-visible'));

    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      track.removeAttribute('data-dragging');
      // A flick of more than 0.35 px/ms moves one panel; otherwise snap to the nearest.
      const flick = velocity < -0.35 ? 1 : velocity > 0.35 ? -1 : 0;
      goTo(current() + flick);
    };

    track.addEventListener('pointerup', (e) => {
      const isTap =
        Math.hypot(e.clientX - startX, e.clientY - startY) < TAP_MAX_MOVE &&
        performance.now() - startT < TAP_MAX_MS;
      const target = tapTarget;
      tapTarget = null;
      if (dragging) {
        if (isTap) {
          dragging = false;
          track.removeAttribute('data-dragging');
        } else endDrag();
      }
      if (!isTap || !target || target.closest('a, button')) return;
      const i = panels.indexOf(target.closest<HTMLElement>('[data-focus-panel]')!);
      if (i >= 0) activate(i);
    });
    track.addEventListener('pointercancel', () => {
      tapTarget = null;
      endDrag();
    });

    // Ruler: drag or swipe the scale to scrub the track; tap a stop to jump to it.
    // 44px touch targets come from the stop columns (one step wide, full ruler height).
    if (rulerView) {
      let rDragging = false;
      let rStartX = 0;
      let rStartT = 0;
      let rStartP = 0;
      let rLastX = 0;
      let rLastT = 0;
      let rVelocity = 0;
      let rTarget: Element | null = null;

      rulerView.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        rDragging = true;
        rStartX = rLastX = e.clientX;
        rStartT = rLastT = performance.now();
        rStartP = position();
        rVelocity = 0;
        rTarget = e.target as Element;
        rulerView.setPointerCapture(e.pointerId);
        track.setAttribute('data-dragging', '');
      });
      rulerView.addEventListener('pointermove', (e) => {
        if (!rDragging) return;
        const p = rStartP - (e.clientX - rStartX) / stepPx();
        const clamped = Math.max(0, Math.min(count - 1, p));
        track.scrollLeft = clamped * track.clientWidth;
        const now = performance.now();
        if (now > rLastT) rVelocity = (e.clientX - rLastX) / (now - rLastT);
        rLastX = e.clientX;
        rLastT = now;
      });
      const rEnd = (e: PointerEvent, cancelled: boolean) => {
        if (!rDragging) return;
        rDragging = false;
        track.removeAttribute('data-dragging');
        const stop = rTarget?.closest<HTMLElement>('[data-stop]');
        const isTap =
          !cancelled &&
          Math.abs(e.clientX - rStartX) < TAP_MAX_MOVE &&
          performance.now() - rStartT < 400;
        if (isTap && stop) {
          goTo(Number(stop.dataset.stop));
          return;
        }
        // Ruler content moves with the finger, so a leftward flick advances.
        const flick = rVelocity < -0.35 ? 1 : rVelocity > 0.35 ? -1 : 0;
        goTo(Math.round(position()) + flick);
      };
      rulerView.addEventListener('pointerup', (e) => rEnd(e, false));
      rulerView.addEventListener('pointercancel', (e) => rEnd(e, true));
    }

    // Keyboard and assistive tech reach the stops as buttons; the markup stays inert without JS.
    rulerStops.forEach((s, i) => {
      s.setAttribute('role', 'button');
      s.setAttribute('tabindex', '0');
      // The accessible name contains all the visible text (WCAG 2.5.3).
      const text = s.textContent ?? '';
      s.setAttribute('aria-label', text.replace(/\s+/g, ' ').trim());
      s.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          goTo(i);
        }
      });
    });

    let ticking = false;
    track.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          paintRuler();
          paint();
        });
      },
      { passive: true },
    );

    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (e) => {
      reduced = e.matches;
    });

    // Restore the panel named in the URL, if any. Out-of-range values clamp to the ends.
    const wanted = Number(new URL(location.href).searchParams.get('panel'));
    if (Number.isInteger(wanted) && wanted !== 0) {
      requestAnimationFrame(() => {
        goTo(wanted);
        paintRuler();
      });
    } else {
      paintRuler();
      paint();
    }
  }
</script>

<style>
  .focus-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    /* The header is fixed on the home route, so the track fills the viewport exactly and the
       footer sits entirely below the fold with no vertical page scroll. */
    height: 100dvh;
  }
  .focus-track::-webkit-scrollbar {
    display: none;
  }
  .focus-panel {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: grid;
    align-items: end;
    justify-items: start;
    /* Top padding clears the fixed navbar pill (48px header + pill height). */
    padding: 7.5rem 1.5rem 9.5rem;
    overflow: hidden;
    color: #f7f5f0;
  }
  @media (hover: hover) and (pointer: fine) {
    .focus-panel {
      cursor: zoom-in;
    }
  }
  /* Full-bleed photograph: edge to edge, no card, no border, no gap.
     The panel itself is not a stacking context, so the home figure field can sit between the
     photograph and the text. Depth of field lives on the photo layer, not on the panel. */
  .focus-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    /* Depth of field: only panels JavaScript marks non-focused are blurred and dimmed.
     Default (no-JS) is the sharp, fully opaque photo. */
  }
  .focus-panel[data-focus-state='neighbour'] .focus-photo {
    filter: blur(6px) saturate(0.85);
    opacity: 0.55;
    transform: scale(0.96);
  }
  @media (prefers-reduced-motion: no-preference) {
    .focus-photo {
      transition:
        filter 600ms var(--ease-spring),
        opacity 600ms var(--ease-spring),
        transform 600ms var(--ease-spring);
    }
  }
  .focus-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Legibility scrim. Strong on the text side so the title and body clear WCAG AA in both themes. */
  .focus-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
    /* One continuous gradient: opaque only behind the bottom text block, easing away to the
       top edge so the photograph stays unobstructed. No banded stops. */
    background: linear-gradient(
      to top,
      rgb(8 7 6 / 0.94) 0%,
      rgb(8 7 6 / 0.86) 22%,
      rgb(8 7 6 / 0.6) 46%,
      rgb(8 7 6 / 0.24) 72%,
      rgb(8 7 6 / 0.08) 100%
    );
  }
  .focus-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 34rem;
    text-align: left;
  }
  .focus-index {
    color: rgb(247 245 240 / 0.88);
  }
  .focus-title {
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #f7f5f0;
    text-shadow: 0 2px 18px rgb(8 7 6 / 0.55);
  }
  .focus-body {
    color: rgb(247 245 240 / 0.92);
    max-width: 30rem;
    text-wrap: balance;
    text-shadow: 0 1px 12px rgb(8 7 6 / 0.6);
  }
  .focus-cta {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    border-radius: var(--radius-key);
    border: 1px solid rgb(247 245 240 / 0.5);
    color: #f7f5f0;
    padding: 0 1rem;
    transition:
      background-color 300ms var(--ease-spring),
      color 300ms var(--ease-spring),
      transform 300ms var(--ease-spring);
  }
  .focus-cta:hover,
  .focus-cta:focus-visible {
    background: #f7f5f0;
    color: #16150f;
    transform: translateY(-1px);
    outline: none;
  }
  .focus-cta:focus-visible {
    box-shadow: 0 0 0 2px #f7f5f0;
  }

  /* The fixed navbar pill floats over the photo. Panel text keeps clear of it via panel padding,
     the photo itself runs under it to the top edge. */

