---
/**
 * Hero focus slider: four full-viewport panels on a native `scroll-snap` track.
 * The slider is the home navigation: each panel links into its route.
 * Camera cues are CSS only: depth-of-field blur on the neighbours, viewfinder corner brackets
 * on the focused panel, `zoom-in` cursor on fine pointers.
 *
 * A small inline script adds desktop arrow-key navigation, drag momentum and snap assist.
 * Without JavaScript the track is still a real scroll container with real links.
 */
import { m } from '@/lib/i18n';

interface Panel {
  label: string;
  body: string;
  href: string;
  cta: string;
  route: string;
  photo: { src: string; webp: string; width: number; height: number; alt: string; position: string };
}

/* Full-bleed panel photographs, owner-supplied. Neutral alt text; nothing is claimed about
   the owner. Object position is per panel so `cover` keeps the subject in frame. */
const panelPhotos: Record<string, Panel['photo']> = {
  home: {
    src: '/photos/2024-09-15-1.jpg',
    webp: '/photos/2024-09-15-1.webp',
    width: 1000,
    height: 1000,
    alt: 'Colour photograph of a row of houses beside railway tracks under a cloudy sky.',
    position: 'center',
  },
  research: {
    src: '/photos/2024-10-16-1.jpg',
    webp: '/photos/2024-10-16-1.webp',
    width: 1080,
    height: 1080,
    alt: 'Black-and-white photograph of a laboratory bench with a benchtop centrifuge and glassware by a window.',
    position: 'center',
  },
  life: {
    src: '/photos/2024-10-16-2.jpg',
    webp: '/photos/2024-10-16-2.webp',
    width: 1080,
    height: 1080,
    alt: 'Black-and-white photograph of a seated person holding an ear of corn.',
    position: 'center 30%',
  },
  photography: {
    src: '/photos/2024-10-10-1.jpg',
    webp: '/photos/2024-10-10-1.webp',
    width: 1080,
    height: 1080,
    alt: 'Black-and-white photograph of a bearded person sitting on a chair in a glass-walled lobby.',
    position: 'center 20%',
  },
};

const panels: Panel[] = [
  {
    label: m.hero_intro_label(),
    body: m.hero_intro_body(),
    href: '/life',
    cta: m.nav_life(),
    route: 'home',
    photo: panelPhotos.home!,
  },
  {
    label: m.hero_research_label(),
    body: m.hero_research_body(),
    href: '/research',
    cta: m.nav_research(),
    route: 'research',
    photo: panelPhotos.research!,
  },
  {
    label: m.hero_life_label(),
    body: m.hero_life_body(),
    href: '/life',
    cta: m.nav_life(),
    route: 'life',
    photo: panelPhotos.life!,
  },
  {
    label: m.hero_photography_label(),
    body: m.hero_photography_body(),
    href: '/photography',
    cta: m.nav_photography(),
    route: 'photography',
    photo: panelPhotos.photography!,
  },
];
---

<section
  class="focus-track"
  data-focus-track
  tabindex="0"
  role="group"
  aria-label={m.hero_panels()}
  data-panel-count={panels.length}
>
  {
    panels.map((p, i) => (
      <article
        class="focus-panel"
        data-focus-panel={i}
        data-route={p.route}
        aria-roledescription="panel"
      >
        <picture class="focus-photo">
          <source srcset={`${p.photo.webp} 1x`} type="image/webp" />
          <img
            src={p.photo.src}
            alt={p.photo.alt}
            width={p.photo.width}
            height={p.photo.height}
            style={`object-position:${p.photo.position};`}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </picture>
        <div class="focus-scrim" aria-hidden="true" />
        <span class="viewfinder" aria-hidden="true">
          <i class="corner tl" />
          <i class="corner tr" />
          <i class="corner bl" />
          <i class="corner br" />
        </span>
        <div class="focus-inner">
          <p class="focus-index font-mono text-xs tracking-widest text-muted-foreground uppercase">
            {String(i + 1).padStart(2, '0')} / {String(panels.length).padStart(2, '0')}
          </p>
          {i === 0 ? <h1 class="sr-only">{m.hero_name()}</h1> : null}
          <h2 class="focus-title font-display">{p.label}</h2>
          <p class="focus-body">{p.body}</p>
          <a class="focus-cta" href={p.href}>
            {p.cta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))
  }
</section>

<div class="focus-progress" data-focus-progress>
  <div class="focus-progress-track" data-focus-progress-track role="presentation">
    <span class="focus-progress-fill" data-focus-progress-fill />
  </div>
</div>

<p class="focus-hint" data-focus-hint>{m.hero_hint()}</p>

<script>
  /**
   * Desktop niceties on top of the native scroll-snap track:
   * arrow keys, drag with momentum, and the `?panel=` URL state.
   * Everything degrades to a plain scroll container without JavaScript.
   */
  const track = document.querySelector<HTMLElement>('[data-focus-track]');
  if (track) {
    const panels = [...track.querySelectorAll<HTMLElement>('[data-focus-panel]')];
    const progress = document.querySelector<HTMLElement>('[data-focus-progress]');
    const count = panels.length;
    let index = 0;
    let reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const current = () => {
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      panels.forEach((p, i) => {
        const center = p.offsetLeft + p.clientWidth / 2;
        const d = Math.abs(center - mid);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      return best;
    };

    const paint = () => {
      index = current();
      panels.forEach((p, i) => {
        p.toggleAttribute('data-focused', i === index);
        // Neighbours are dimmed and blurred; the focused panel is sharp.
        p.style.setProperty('--panel-focus', i === index ? '1' : '0');
      });
      // The progress bar fills to (focused + 1) / count. A width write only, so no layout churn.
      if (progress) {
        progress.style.setProperty('--progress', String((index + 1) / count));
      }
      const url = new URL(location.href);
      if (index === 0) url.searchParams.delete('panel');
      else url.searchParams.set('panel', String(index));
      history.replaceState(history.state, '', url);
    };

    const goTo = (i: number) => {
      const next = Math.max(0, Math.min(count - 1, i));
      const panel = panels[next];
      if (!panel) return;
      track.scrollTo({ left: panel.offsetLeft, behavior: reduced ? 'auto' : 'smooth' });
      index = next;
      paint();
    };

    // Arrow keys, when the track (or something inside it) has focus.
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        goTo(index + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        goTo(index - 1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        goTo(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        goTo(count - 1);
      }
    });

    // Drag with momentum: pointer capture, then a flick decides the next panel.
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0;

    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return; // native touch scrolling already works
      dragging = true;
      startX = e.clientX;
      lastX = e.clientX;
      lastT = performance.now();
      velocity = 0;
      startScroll = track.scrollLeft;
      track.setPointerCapture(e.pointerId);
      track.setAttribute('data-dragging', '');
    });

    track.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      track.scrollLeft = startScroll - dx;
      const now = performance.now();
      const dt = now - lastT;
      if (dt > 0) velocity = (e.clientX - lastX) / dt;
      lastX = e.clientX;
      lastT = now;
    });

    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      track.removeAttribute('data-dragging');
      // A flick of more than 0.35 px/ms moves one panel; otherwise snap to the nearest.
      const flick = velocity < -0.35 ? 1 : velocity > 0.35 ? -1 : 0;
      goTo(index + flick);
    };

    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    let ticking = false;
    track.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          paint();
        });
      },
      { passive: true },
    );

    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (e) => {
      reduced = e.matches;
    });

    // Restore the panel named in the URL, if any. Out-of-range values clamp to the ends.
    const wanted = Number(new URL(location.href).searchParams.get('panel'));
    if (Number.isInteger(wanted) && wanted !== 0) {
      requestAnimationFrame(() => goTo(wanted));
    } else {
      paint();
    }
  }
</script>

<style>
  .focus-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    height: 100dvh;
  }
  .focus-track::-webkit-scrollbar {
    display: none;
  }
  .focus-panel {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: grid;
    align-items: end;
    justify-items: start;
    padding: 6rem 1.5rem 6.5rem;
    overflow: hidden;
    color: #f7f5f0;
  }
  @media (hover: hover) and (pointer: fine) {
    .focus-panel {
      cursor: zoom-in;
    }
  }
  /* Full-bleed photograph: edge to edge, no card, no border, no gap.
     The panel itself is not a stacking context, so the home figure field can sit between the
     photograph and the text. Depth of field lives on the photo layer, not on the panel. */
  .focus-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    /* Depth of field: neighbours are blurred and dimmed. */
    filter: blur(6px) saturate(0.85);
    opacity: 0.55;
    transform: scale(0.96);
    transition:
      filter 600ms var(--ease-spring),
      opacity 600ms var(--ease-spring),
      transform 600ms var(--ease-spring);
  }
  .focus-panel[data-focused] .focus-photo {
    filter: blur(0) saturate(1);
    opacity: 1;
    transform: scale(1);
  }
  .focus-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Legibility scrim. Strong on the text side so the title and body clear WCAG AA in both themes. */
  .focus-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(to top, rgb(8 7 6 / 0.92) 0%, rgb(8 7 6 / 0.78) 26%, rgb(8 7 6 / 0.42) 52%, rgb(8 7 6 / 0.16) 78%, rgb(8 7 6 / 0.34) 100%),
      linear-gradient(to right, rgb(8 7 6 / 0.5) 0%, rgb(8 7 6 / 0.12) 60%, rgb(8 7 6 / 0.3) 100%);
  }
  .focus-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 34rem;
    text-align: left;
  }
  .focus-index {
    color: rgb(247 245 240 / 0.88);
  }
  .focus-title {
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #f7f5f0;
    text-shadow: 0 2px 18px rgb(8 7 6 / 0.55);
  }
  .focus-body {
    color: rgb(247 245 240 / 0.92);
    max-width: 30rem;
    text-wrap: balance;
    text-shadow: 0 1px 12px rgb(8 7 6 / 0.6);
  }
  .focus-cta {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    border-radius: var(--radius-key);
    border: 1px solid rgb(247 245 240 / 0.5);
    color: #f7f5f0;
    padding: 0 1rem;
    transition:
      background-color 300ms var(--ease-spring),
      color 300ms var(--ease-spring),
      transform 300ms var(--ease-spring);
  }
  .focus-cta:hover,
  .focus-cta:focus-visible {
    background: #f7f5f0;
    color: #16150f;
    transform: translateY(-1px);
    outline: none;
  }
  .focus-cta:focus-visible {
    box-shadow: 0 0 0 2px #f7f5f0;
  }

  /* Viewfinder corner brackets on the focused panel. */
  .viewfinder {
    position: absolute;
    inset: clamp(1rem, 4vh, 3rem) clamp(1rem, 5vw, 4rem);
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms var(--ease-spring);
  }
  .focus-panel[data-focused] .viewfinder {
    opacity: 0.7;
  }
  .corner {
    position: absolute;
    width: clamp(1.25rem, 3vw, 2.25rem);
    height: clamp(1.25rem, 3vw, 2.25rem);
    border: 2px solid rgb(247 245 240 / 0.85);
  }
  .corner.tl {
    top: 0;
    left: 0;
    border-right: 0;
    border-bottom: 0;
  }
  .corner.tr {
    top: 0;
    right: 0;
    border-left: 0;
    border-bottom: 0;
  }
  .corner.bl {
    bottom: 0;
    left: 0;
    border-right: 0;
    border-top: 0;
  }
  .corner.br {
    bottom: 0;
    right: 0;
    border-left: 0;
    border-top: 0;
  }

  /* Progress bar on the bottom edge of the viewport: a 2px track with a fill at (focused + 1) / 4. */
  .focus-progress {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 30;
    pointer-events: none;
  }
  .focus-progress-track {
    height: 2px;
    width: 100%;
    background: rgb(255 255 255 / 0.28);
  }
  .focus-progress-fill {
    display: block;
    height: 100%;
    width: calc(var(--progress, 0.25) * 100%);
    background: #f7f5f0;
    transition: width 400ms var(--ease-spring);
  }
  .focus-hint {
    position: fixed;
    bottom: 2.5rem;
    left: 50%;
    translate: -50% 0;
    font-size: 0.75rem;
    color: var(--c-muted-fg);
    z-index: 30;
    text-align: center;
    padding-inline: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .focus-photo {
      filter: none;
      opacity: 1;
      transform: none;
      transition: none;
    }
    .focus-panel:not([data-focused]) .focus-photo {
      opacity: 0.6;
    }
  }
</style>
