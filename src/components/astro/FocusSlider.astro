---
/**
 * Hero focus slider: four full-viewport panels on a native `scroll-snap` track.
 * The slider is the home navigation: each panel links into its route.
 *
 * v3: no background photographs, no scrim, no viewfinder brackets. Each panel is a single
 * section of the paper/ink page. The blur is the depth cue: the panel content is blurred while
 * the focus travels between stops, and the navbar, the ruler and the shutter stay sharp.
 *
 * A small inline script adds desktop arrow-key navigation, drag momentum and snap assist.
 * Without JavaScript the track is still a real scroll container with real links.
 */
import { m } from '@/lib/i18n';
import { FOCUS_STOPS, PANELS, type PanelRoute } from '@/lib/panels';
import { SOCIALS } from '@/lib/site';
import GraduationCap from '~icons/ph/graduation-cap-light';
import IdentificationCard from '~icons/ph/identification-card-light';
import GithubLogo from '~icons/ph/github-logo-light';
import InstagramLogo from '~icons/ph/instagram-logo-light';
import ImagesSquare from '~icons/ph/images-square-light';

interface Panel {
  route: PanelRoute;
  /** Ruler and aria-live label. */
  label: string;
  /** Header of the panel. The Intro panel carries the name as the page h1. */
  header: string;
  /** One-line tagline under the header. */
  tagline: string;
  /** Short list of topics, only on the Research panel. */
  topics?: { key: string; text: string }[];
  /** Drawer route opened by the CTA. Absent on the Intro panel: no CTA there. */
  cta?: { label: string; route: string };
}

/** Icon-only social links. Every URL is already in the repo (`src/lib/site.ts`), plus the
    owner's Instagram. No invented handles. */
const SOCIAL_ICONS = [
  { href: SOCIALS.scholar, label: m.socials_scholar(), Icon: GraduationCap },
  { href: SOCIALS.orcid, label: m.socials_orcid(), Icon: IdentificationCard },
  { href: SOCIALS.github, label: m.socials_github(), Icon: GithubLogo },
  { href: SOCIALS.instagram, label: m.socials_instagram(), Icon: InstagramLogo },
  { href: SOCIALS.portfolio, label: m.socials_portfolio(), Icon: ImagesSquare },
] as const;

/** The panel copy, keyed by route. `PANELS` fixes the order: Intro, Research, Photography, Life. */
const CONTENT: Record<
  PanelRoute,
  {
    label: string;
    header: string;
    tagline: string;
    topics?: { key: string; text: string }[];
    cta?: { label: string; route: string };
  }
> = {
  home: {
    label: m.hero_intro_label(),
    header: m.hero_name(),
    tagline: m.hero_intro_body(),
  },
  research: {
    label: m.hero_research_label(),
    header: m.hero_research_label(),
    tagline: m.hero_research_body(),
    topics: [
      { key: 'hero_research_topic_language', text: m.hero_research_topic_language() },
      { key: 'hero_research_topic_variants', text: m.hero_research_topic_variants() },
      { key: 'hero_research_topic_diversity', text: m.hero_research_topic_diversity() },
      { key: 'hero_research_topic_biology', text: m.hero_research_topic_biology() },
    ],
    cta: { label: m.overlay_research_read_more(), route: 'research' },
  },
  photography: {
    label: m.hero_photography_label(),
    header: m.hero_photography_label(),
    tagline: m.hero_photography_body(),
    cta: { label: m.overlay_photography_read_more(), route: 'photography' },
  },
  life: {
    label: m.hero_life_label(),
    header: m.hero_life_label(),
    tagline: m.hero_life_body(),
    cta: { label: m.overlay_life_read_more(), route: 'life' },
  },
};

const panels: Panel[] = PANELS.map((p) => panelFor(p.route));

function panelFor(route: PanelRoute): Panel {
  const c = CONTENT[route];
  return {
    route,
    label: c.label,
    header: c.header,
    tagline: c.tagline,
    ...(c.topics ? { topics: c.topics } : {}),
    ...(c.cta ? { cta: c.cta } : {}),
  };
}
---

<section
  class="focus-track"
  data-focus-track
  tabindex="0"
  role="group"
  aria-label={m.hero_panels()}
  data-panel-count={panels.length}
>
  {
    panels.map((p, i) => (
      <article
        class="focus-panel"
        data-focus-panel={i}
        data-route={p.route}
        aria-roledescription="panel"
      >
        <div class="focus-content" data-focus-content>
          <p class="focus-index font-mono text-xs tracking-widest text-muted-foreground uppercase">
            {String(i + 1).padStart(2, '0')} / {String(panels.length).padStart(2, '0')}
          </p>
          {i === 0 ? (
            <h1 class="focus-title font-display">{p.header}</h1>
          ) : (
            <h2 class="focus-title font-display">{p.header}</h2>
          )}
          <p class="focus-body">{p.tagline}</p>
          {p.topics && (
            <ul class="focus-topics">
              {p.topics.map((t) => (
                <li class="focus-topic">
                  <span class="focus-topic-dot" aria-hidden="true" />
                  <span data-i18n={t.key}>{t.text}</span>
                </li>
              ))}
            </ul>
          )}
          {i === 0 ? (
            <ul class="focus-socials" aria-label={m.hero_social_aria()}>
              {SOCIAL_ICONS.map(({ href, label, Icon }) => (
                <li>
                  <a
                    href={href}
                    rel="me noopener"
                    class="focus-social"
                    title={label}
                    aria-label={label}
                  >
                    <Icon aria-hidden="true" className="size-5" />
                  </a>
                </li>
              ))}
            </ul>
          ) : null}
          {p.cta && (
            /* A real link so the panel works without JavaScript. With JS the click is
               intercepted and the drawer opens instead of a page navigation. */
            <a class="focus-cta" href={`/${p.cta.route}`} data-focus-cta={p.cta.route}>
              {p.cta.label}
              <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </article>
    ))
  }
</section>

<div class="focus-progress" data-focus-progress>
  <div class="focus-progress-track" data-focus-progress-track role="presentation">
    <span class="focus-progress-fill" data-focus-progress-fill />
  </div>
</div>

<div class="focus-ruler" data-focus-ruler>
  <div class="ruler-viewport" data-ruler-viewport>
    <div class="ruler-strip" data-ruler-strip>
      {
        panels.map((p, i) => (
          <span class="ruler-stop" data-stop={i} data-label={p.label} style={`--i:${i};`}>
            <span class="ruler-label font-mono">
              {String(i + 1).padStart(2, '0')} {p.label}
            </span>
            <span class="ruler-dot" />
            <span class="ruler-num font-mono">{FOCUS_STOPS[i]}</span>
          </span>
        ))
      }
    </div>
    <span class="ruler-needle" aria-hidden="true"></span>
  </div>
  <p class="ruler-readout font-mono" aria-hidden="true">
    FOCUS <span data-focus-value>{FOCUS_STOPS[0]}</span> M
  </p>
</div>

<p class="sr-only" data-focus-live aria-live="polite" aria-atomic="true"></p>

<p class="sr-only" data-focus-hint>{m.hero_hint()}</p>

<span class="focus-chip font-mono" data-focus-chip aria-hidden="true">‹ ›</span>

<script>
  /**
   * Behaviour on top of the native scroll-snap track: arrow keys, drag with momentum, the
   * `?panel=` URL state, the focus-scale ruler, the depth-of-field blur and tap / Enter activation.
   * Everything degrades to a plain scroll container with real links when JavaScript is off.
   */
  const track = document.querySelector<HTMLElement>('[data-focus-track]');
  if (track) {
    const panels = [...track.querySelectorAll<HTMLElement>('[data-focus-panel]')];
    const contents = [...track.querySelectorAll<HTMLElement>('[data-focus-content]')];
    const progress = document.querySelector<HTMLElement>('[data-focus-progress]');
    const ruler = document.querySelector<HTMLElement>('[data-focus-ruler]');
    const rulerView = document.querySelector<HTMLElement>('[data-ruler-viewport]');
    const rulerStops = [...document.querySelectorAll<HTMLElement>('[data-stop]')];
    const readout = document.querySelector<HTMLElement>('[data-focus-value]');
    const live = document.querySelector<HTMLElement>('[data-focus-live]');
    const chip = document.querySelector<HTMLElement>('[data-focus-chip]');
    const count = panels.length;
    // Focus distance per panel, text only. Mirrors the stops rendered in the markup.
    const stopValues = [0.3, 0.5, 0.7, 1.0];
    // Same literal as `OPEN_OVERLAY_EVENT` in FocusOverlays.tsx (the island is not imported here).
    const OPEN_OVERLAY_EVENT = 'ananthan:open-overlay';
    const TAP_MAX_MOVE = 6;
    const TAP_MAX_MS = 250;
    let index = 0;
    let reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const current = () => {
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      panels.forEach((p, i) => {
        const center = p.offsetLeft + p.clientWidth / 2;
        const d = Math.abs(center - mid);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      return best;
    };

    /** Fractional panel position, 0..count-1, from the track scroll offset. */
    const position = () => {
      const w = track.clientWidth || 1;
      return Math.max(0, Math.min(count - 1, track.scrollLeft / w));
    };

    /** Ruler step in px: distance between two adjacent stops. */
    const stepPx = () => {
      const a = rulerStops[0];
      const b = rulerStops[1];
      return a && b ? b.offsetLeft - a.offsetLeft || 1 : 1;
    };

    // Ruler paint: one custom property drives the strip transform (no layout), and the
    // readout interpolates between the two surrounding stops.
    const paintRuler = () => {
      const p = position();
      ruler?.style.setProperty('--p', p.toFixed(4));
      if (readout) {
        const lo = Math.floor(p);
        const hi = Math.min(count - 1, lo + 1);
        const t = p - lo;
        const v = stopValues[lo]! + (stopValues[hi]! - stopValues[lo]!) * t;
        readout.textContent = v.toFixed(2);
      }
    };

    /**
     * Depth of field: each panel's content is blurred by its distance from the nearest stop,
     * so the blur follows the finger continuously and is sharp exactly on a stop. The navbar,
     * the ruler and the shutter are outside this layer, so they stay sharp. JS-gated (the
     * custom property is only written here) and off under reduced motion.
     */
    const paintFocus = () => {
      const p = position();
      contents.forEach((el, i) => {
        const distance = Math.abs(p - i);
        // 0 at the stop, 1 half-way between two stops.
        const t = Math.min(1, distance);
        el.style.setProperty('--focus-blur', `${(t * 7).toFixed(2)}px`);
        el.style.setProperty('--focus-dim', (t * 0.55).toFixed(3));
      });
    };

    const paint = () => {
      const prev = index;
      index = current();
      panels.forEach((p, i) => {
        p.toggleAttribute('data-focused', i === index);
      });
      rulerStops.forEach((s, i) => {
        s.toggleAttribute('data-focused', i === index);
      });
      if (live && (index !== prev || !live.textContent)) {
        live.textContent = panels[index]?.querySelector('.focus-title')?.textContent ?? '';
      }
      // The progress bar fills to (focused + 1) / count. A width write only, so no layout churn.
      if (progress) {
        progress.style.setProperty('--progress', String((index + 1) / count));
      }
      const url = new URL(location.href);
      if (index === 0) url.searchParams.delete('panel');
      else url.searchParams.set('panel', String(index));
      history.replaceState(history.state, '', url);
    };

    const goTo = (i: number) => {
      const next = Math.max(0, Math.min(count - 1, i));
      const panel = panels[next];
      if (!panel) return;
      track.scrollTo({ left: panel.offsetLeft, behavior: reduced ? 'auto' : 'smooth' });
      index = next;
      paint();
    };

    /** Open the drawer for a panel. The island listens for the event; without it, follow the link. */
    const openPanel = (route: string) => {
      if (!route) return;
      if (document.documentElement.hasAttribute('data-overlay-ready')) {
        window.dispatchEvent(new CustomEvent(OPEN_OVERLAY_EVENT, { detail: route }));
      } else {
        // No island (no JS): a plain navigation to the page is the fallback.
        location.assign(`/${route === 'home' ? '' : route}`);
      }
    };

    /** Tap, click or Enter on a panel: focus it, or open it if it already has focus. */
    const activate = (i: number) => {
      if (document.documentElement.hasAttribute('data-overlay-open')) return;
      if (i !== index) {
        goTo(i);
        return;
      }
      const panel = panels[i];
      const route = panel?.dataset.route;
      // The Intro panel has no drawer: activating it advances to the first real panel.
      if (!route || route === 'home') {
        goTo(1);
        return;
      }
      openPanel(route);
    };

    // Keys, when the track itself has focus.
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        goTo(index + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        goTo(index - 1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        goTo(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        goTo(count - 1);
      } else if ((e.key === 'Enter' || e.key === ' ') && e.target === track) {
        e.preventDefault();
        activate(index);
      }
    });

    // The CTA is a real link for no-JS. With JS it opens the drawer for its panel instead.
    track.addEventListener('click', (e) => {
      const cta = (e.target as Element).closest<HTMLElement>('[data-focus-cta]');
      if (!cta || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      const route = cta.dataset['focusCta'];
      if (route) openPanel(route);
    });

    // Pointer handling on the track. Touch scrolls natively; mouse drags with momentum.
    // A tap is movement < 6px and < 250ms; only a tap can activate, so a flick never opens anything.
    let dragging = false;
    let captured = false;
    let startX = 0;
    let startY = 0;
    let startT = 0;
    let startScroll = 0;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0;
    let tapTarget: Element | null = null;

    track.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      startX = e.clientX;
      startY = e.clientY;
      startT = performance.now();
      tapTarget = e.target as Element;
      if (e.pointerType === 'touch') return; // native touch scrolling already works
      dragging = true;
      captured = false;
      lastX = e.clientX;
      lastT = startT;
      velocity = 0;
      startScroll = track.scrollLeft;
      track.setAttribute('data-dragging', '');
    });

    track.addEventListener('pointermove', (e) => {
      if (chip && e.pointerType !== 'touch') {
        chip.style.transform = `translate3d(${e.clientX + 16}px, ${e.clientY + 16}px, 0)`;
        chip.toggleAttribute('data-visible', true);
      }
      if (!dragging) return;
      const dx = e.clientX - startX;
      // Capture only once it is a real drag, so a plain click still reaches links.
      if (!captured && Math.abs(dx) > TAP_MAX_MOVE) {
        captured = true;
        track.setPointerCapture(e.pointerId);
      }
      track.scrollLeft = startScroll - dx;
      const now = performance.now();
      const dt = now - lastT;
      if (dt > 0) velocity = (e.clientX - lastX) / dt;
      lastX = e.clientX;
      lastT = now;
    });

    track.addEventListener('pointerleave', () => chip?.removeAttribute('data-visible'));

    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      track.removeAttribute('data-dragging');
      // A flick of more than 0.35 px/ms moves one panel; otherwise snap to the nearest.
      const flick = velocity < -0.35 ? 1 : velocity > 0.35 ? -1 : 0;
      goTo(current() + flick);
    };

    track.addEventListener('pointerup', (e) => {
      const isTap =
        Math.hypot(e.clientX - startX, e.clientY - startY) < TAP_MAX_MOVE &&
        performance.now() - startT < TAP_MAX_MS;
      const target = tapTarget;
      tapTarget = null;
      if (dragging) {
        if (isTap) {
          dragging = false;
          track.removeAttribute('data-dragging');
        } else endDrag();
      }
      if (!isTap || !target || target.closest('a, button')) return;
      const i = panels.indexOf(target.closest<HTMLElement>('[data-focus-panel]')!);
      if (i >= 0) activate(i);
    });
    track.addEventListener('pointercancel', () => {
      tapTarget = null;
      endDrag();
    });

    // Ruler: drag or swipe the scale to scrub the track; tap a stop to jump to it.
    // 44px touch targets come from the stop columns (one step wide, full ruler height).
    if (rulerView) {
      let rDragging = false;
      let rStartX = 0;
      let rStartT = 0;
      let rStartP = 0;
      let rLastX = 0;
      let rLastT = 0;
      let rVelocity = 0;
      let rTarget: Element | null = null;

      rulerView.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        rDragging = true;
        rStartX = rLastX = e.clientX;
        rStartT = rLastT = performance.now();
        rStartP = position();
        rVelocity = 0;
        rTarget = e.target as Element;
        rulerView.setPointerCapture(e.pointerId);
        track.setAttribute('data-dragging', '');
      });
      rulerView.addEventListener('pointermove', (e) => {
        if (!rDragging) return;
        const p = rStartP - (e.clientX - rStartX) / stepPx();
        const clamped = Math.max(0, Math.min(count - 1, p));
        track.scrollLeft = clamped * track.clientWidth;
        const now = performance.now();
        if (now > rLastT) rVelocity = (e.clientX - rLastX) / (now - rLastT);
        rLastX = e.clientX;
        rLastT = now;
      });
      const rEnd = (e: PointerEvent, cancelled: boolean) => {
        if (!rDragging) return;
        rDragging = false;
        track.removeAttribute('data-dragging');
        const stop = rTarget?.closest<HTMLElement>('[data-stop]');
        const isTap =
          !cancelled &&
          Math.abs(e.clientX - rStartX) < TAP_MAX_MOVE &&
          performance.now() - rStartT < 400;
        if (isTap && stop) {
          goTo(Number(stop.dataset.stop));
          return;
        }
        // Ruler content moves with the finger, so a leftward flick advances.
        const flick = rVelocity < -0.35 ? 1 : rVelocity > 0.35 ? -1 : 0;
        goTo(Math.round(position()) + flick);
      };
      rulerView.addEventListener('pointerup', (e) => rEnd(e, false));
      rulerView.addEventListener('pointercancel', (e) => rEnd(e, true));
    }

    // Keyboard and assistive tech reach the stops as buttons; the markup stays inert without JS.
    rulerStops.forEach((s, i) => {
      s.setAttribute('role', 'button');
      s.setAttribute('tabindex', '0');
      // The accessible name contains all the visible text (WCAG 2.5.3).
      const text = s.textContent ?? '';
      s.setAttribute('aria-label', text.replace(/\s+/g, ' ').trim());
      s.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          goTo(i);
        }
      });
    });

    let ticking = false;
    track.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          paintRuler();
          paintFocus();
          paint();
        });
      },
      { passive: true },
    );

    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (e) => {
      reduced = e.matches;
      if (reduced) {
        // Reduced motion: nothing blurs.
        contents.forEach((el) => {
          el.style.removeProperty('--focus-blur');
          el.style.removeProperty('--focus-dim');
        });
      } else {
        paintFocus();
      }
    });

    // Restore the panel named in the URL, if any. Out-of-range values clamp to the ends.
    const wanted = Number(new URL(location.href).searchParams.get('panel'));
    if (Number.isInteger(wanted) && wanted !== 0) {
      requestAnimationFrame(() => {
        goTo(wanted);
        paintRuler();
        paintFocus();
      });
    } else {
      paintRuler();
      paintFocus();
      paint();
    }
  }
</script>

<style>
  .focus-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    /* The header is fixed on the home route, so the track fills the viewport exactly and the
       footer sits entirely below the fold with no vertical page scroll. */
    height: 100dvh;
  }
  .focus-track::-webkit-scrollbar {
    display: none;
  }
  .focus-panel {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: grid;
    align-items: end;
    justify-items: start;
    /* Top padding clears the fixed navbar pill (48px header + pill height). */
    padding: 7.5rem 1.5rem 11.75rem;
    overflow: hidden;
  }
  @media (hover: hover) and (pointer: fine) {
    .focus-panel {
      cursor: zoom-in;
    }
  }
  /* The content layer is the only thing that blurs: the navbar, the ruler and the shutter live
     outside it. `--focus-blur` is only ever written by the script, so there is no blur without
     JavaScript, and the reduced-motion rule below removes it entirely. */
  .focus-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 34rem;
    text-align: left;
    filter: blur(var(--focus-blur, 0px));
    opacity: calc(1 - var(--focus-dim, 0));
    will-change: filter, opacity;
  }
  @media (prefers-reduced-motion: no-preference) {
    .focus-content {
      transition:
        filter 260ms var(--ease-spring),
        opacity 260ms var(--ease-spring);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .focus-content {
      filter: none !important;
      opacity: 1 !important;
    }
  }
  .focus-index {
    color: var(--c-muted-fg);
  }
  .focus-title {
    font-size: clamp(2.5rem, 8.5vw, 5.25rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--c-fg);
  }
  .focus-body {
    color: var(--c-muted-fg);
    max-width: 30rem;
    text-wrap: balance;
  }
  /* Research topic list: a short, scannable list of what he works on. */
  .focus-topics {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.25rem;
    max-width: 32rem;
  }
  .focus-topic {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--c-ink-soft);
  }
  .focus-topic-dot {
    flex: none;
    width: 0.35rem;
    height: 0.35rem;
    translate: 0 -0.15rem;
    border-radius: 50%;
    background: var(--c-brand);
  }
  /* Social links: icon-only, 44px targets, ink on paper. */
  .focus-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .focus-social {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: var(--radius-key);
