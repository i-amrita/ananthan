---
import { NavbarActions } from '@/components/react/NavbarActions';
import { m } from '@/lib/i18n';
---

<header
  data-site-nav
  class="pointer-events-none fixed inset-x-0 top-0 z-40 flex justify-center px-3 pt-[calc(env(safe-area-inset-top)+0.75rem)]"
>
  <nav
    class="pointer-events-auto flex w-max max-w-full flex-wrap items-center justify-center rounded-3xl bg-surface p-0.5 shadow-[0_12px_32px_-12px_rgb(28_16_18/0.4)] ring-1 ring-fg/20 backdrop-blur"
    aria-label={m.nav_primary()}
    data-i18n-aria="nav_primary"
  >
    <NavbarActions pathname={Astro.url.pathname} client:load />
  </nav>
</header>
