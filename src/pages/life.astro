---
import ProseLayout from '@/components/astro/ProseLayout.astro';
import { m } from '@/lib/i18n';
import { SOCIALS } from '@/lib/site';

const HOBBIES = [
  { key: 'life_photography', body: 'life_photography_body' },
  { key: 'life_dance', body: 'life_dance_body' },
  { key: 'life_rowing', body: 'life_rowing_body' },
  { key: 'life_cooking', body: 'life_cooking_body' },
  { key: 'life_environment', body: 'life_environment_body' },
] as const;

const SOCIAL_LINKS = [
  { href: SOCIALS.scholar, label: m.socials_scholar() },
  { href: SOCIALS.orcid, label: m.socials_orcid() },
  { href: SOCIALS.github, label: m.socials_github() },
  { href: SOCIALS.instagram, label: m.socials_instagram() },
  { href: SOCIALS.portfolio, label: m.socials_portfolio() },
];
---

<ProseLayout title="Life" eyebrow="Off the clock" description={m.life_intro()} mdHref="/life.md">
  <p data-i18n="life_intro">{m.life_intro()}</p>

  <section class="flex flex-col gap-4">
    <h2 class="font-display text-2xl" id="hobbies" data-i18n="life_hobbies_heading">{m.life_hobbies_heading()}</h2>
    <dl class="flex flex-col gap-4">
      {
        HOBBIES.map(({ key, body }) => (
          <div class="flex flex-col gap-1">
            <dt class="font-display text-lg" data-i18n={key}>
              {m[key]()}
            </dt>
            <dd class="text-sm leading-relaxed text-muted-foreground" data-i18n={body}>
              {m[body]()}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="font-display text-2xl" id="bio" data-i18n="life_bio_heading">{m.life_bio_heading()}</h2>
    <p class="leading-relaxed" data-i18n="life_bio">{m.life_bio()}</p>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="font-display text-2xl" id="career" data-i18n="life_career_heading">{m.life_career_heading()}</h2>
    <p class="leading-relaxed text-muted-foreground" data-i18n="life_career">{m.life_career()}</p>
  </section>

  <section slot="after" class="flex flex-col gap-3 border-t border-border pt-6">
    <h2 class="font-key text-xs tracking-wide text-muted-foreground uppercase" data-i18n="socials_aria">
      {m.socials_aria()}
    </h2>
    <ul class="flex flex-wrap gap-x-4 gap-y-1">
      {
        SOCIAL_LINKS.map((l) => (
          <li>
            <a
              href={l.href}
              rel="me noopener"
              class="inline-flex min-h-11 items-center text-sm underline decoration-border underline-offset-4 transition-colors duration-300 ease-(--ease-spring) hover:text-brand hover:decoration-brand"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</ProseLayout>
