---
import FigureField from '@/components/astro/FigureField.astro';
import FocusSlider from '@/components/astro/FocusSlider.astro';
import Navbar from '@/components/astro/Navbar.astro';
import Base from '@/layouts/Base.astro';

---

<Base
  title="Ananthan Nambiar"
  description="Machine learning for computational biology, and the life outside the lab."
  mdHref="/index.md"
  route="home"
>
  <Navbar slot="header" />
  <main id="main" class="relative">
    <FocusSlider />
  </main>
</Base>

  <FigureField route="home" depth={1} />

<style>
  /* Home is a viewport-height slider: the page must not scroll vertically. The header is sticky
     (48px in flow) and the footer would follow the track, so clip the overflow on the home body. */
  :global(html:has([data-focus-track])),
  :global(body:has([data-focus-track])) {
    height: 100dvh;
    overflow: clip;
  }
  /* On the home route the ink figures float over the full-bleed photographs. The photo layer is
     z-index 0 and the panel text z-index 2, so a fixed field at z-index 1 sits between them.
     Lighter weight so the strokes read as an overlay against a photograph, not against paper. */
  :global([data-figure-field][data-route='home']) {
    z-index: 1;
  }
  :global([data-figure-field][data-route='home'] g) {
    stroke-width: 3;
  }
  :global([data-figure-field][data-route='home'] [data-stroke]) {
    opacity: 0.4 !important;
  }
</style>
