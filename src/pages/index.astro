---
import Navbar from '@/components/astro/Navbar.astro';
import Base from '@/layouts/Base.astro';
import { m } from '@/lib/i18n';
---

<Base title="Ananthan Nambiar" description="Machine learning for computational biology, and the life outside the lab." mdHref="/index.md">
  <Navbar slot="header" />
  <main id="main" class="mx-auto flex max-w-3xl flex-col gap-6 px-6 py-24">
    <h1 class="font-display text-4xl">{m.hero_name()}</h1>
    <p class="text-muted-foreground">{m.hero_subtitle()}</p>
    <nav class="flex flex-wrap gap-3">
      <a class="rounded-key bg-brand px-4 py-2 text-brand-fg" href="/research">Research</a>
      <a class="rounded-key border border-border px-4 py-2" href="/life">Life</a>
      <a class="rounded-key border border-border px-4 py-2" href="/photography">Photography</a>
    </nav>
  </main>
</Base>
