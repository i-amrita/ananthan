---
import { m } from '@/lib/i18n';
import Base from '@/layouts/Base.astro';
import Navbar from '@/components/astro/Navbar.astro';
import { SearchPage } from '@/components/react/SearchPage';
---

<Base title="Search | Ananthan Nambiar" description="Search publications, talks and pages.">
  <Navbar slot="header" />
  <main id="main" class="mx-auto flex max-w-2xl flex-col gap-6 px-6 py-12">
    <h1 class="font-display text-4xl" data-i18n="nav_search">{m.nav_search()}</h1>
    <SearchPage client:load />
    <noscript>
      <p class="text-sm text-muted-foreground">
        Search runs in your browser and needs JavaScript. Without it, browse the <a class="text-brand underline" href="/research">research</a>,
        <a class="text-brand underline" href="/life">life</a> or <a class="text-brand underline" href="/llms.txt">llms.txt</a>.
      </p>
    </noscript>
  </main>
</Base>
